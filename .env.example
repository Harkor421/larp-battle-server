# ---- Server ----
PORT=3000

# ---- OpenAI (judge + free image moderation) ----
OPENAI_API_KEY=sk-...
JUDGE_MODEL=gpt-4.1-mini

# ---- TURN (self-hosted coturn, see coturn/DEPLOY.md) ----
# Must match static-auth-secret in /etc/turnserver.conf
TURN_HOST=turn.yourdomain.com
TURN_SECRET=change-me-openssl-rand-hex-32
TURN_TTL_SECONDS=3600
STUN_URLS=stun:stun.l.google.com:19302

# ---- Battle ----
BATTLE_DURATION_MS=60000
FRAME_INTERVAL_MS=1000
READY_TIMEOUT_MS=25000

# ---- Abuse limits ----
# Trusted reverse-proxy hops in front of this server: Railway = 1, Cloudflare
# in front of Railway = 2. Local dev with no proxy = 0. Wrong value = spoofable
# client IPs (ban bypass), so set it to match your actual deployment.
TRUST_PROXY_HOPS=1
MAX_CONN_PER_IP=8
# Allow two connections from the same IP to be matched (self-battle). Keep false
# in production; set true only to test solo in two tabs or during launch.
ALLOW_SAME_IP_MATCH=false

# ---- Admin panel (leave unset to disable /admin) ----
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# ---- Frames ----
MAX_FRAME_BYTES=400000
MAX_STORED_FRAMES_PER_PLAYER=180
MIN_FRAME_GAP_MS=700
# 0-64; higher = more aggressive dedupe of near-identical consecutive frames
DEDUPE_HAMMING_THRESHOLD=5

# ---- Judging ----
# Frames per player actually sent to GPT-4.1-mini (sampled evenly across the
# battle). ~$0.02/battle at 24. Set JUDGE_ALL_FRAMES=true to send every stored
# frame instead (~$0.10-0.13/battle at 1 fps).
MAX_JUDGE_FRAMES_PER_PLAYER=24
JUDGE_ALL_FRAMES=false

# ---- Moderation (OpenAI omni-moderation-latest — free) ----
# Check every Nth received frame; 0 disables (don't disable in production)
MODERATION_EVERY_N_FRAMES=5
MODERATION_ABORT_CATEGORIES=sexual,sexual/minors

# ---- Storage ----
DATA_DIR=data
